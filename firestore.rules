rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // 1. UserProfile Blueprint Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'userId', 'name', 'age', 'gender', 'heightCm', 'currentWeightKg', 'targetWeightKg',
          'fitnessLevel', 'fitnessGoal', 'workoutPreference', 'equipment', 'dietaryPreference',
          'dailyCalorieGoal', 'dailyProteinGoalG', 'dailyCarbsGoalG', 'dailyFatGoalG',
          'dailyStepsGoal', 'dailyWaterGoalMl', 'dailySleepGoalHours', 'dailyActiveMinutesGoal',
          'onboardingCompleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'name', 'age', 'gender', 'heightCm', 'currentWeightKg', 'targetWeightKg',
          'fitnessLevel', 'fitnessGoal', 'workoutPreference', 'equipment', 'dietaryPreference',
          'dailyCalorieGoal', 'dailyProteinGoalG', 'dailyCarbsGoalG', 'dailyFatGoalG',
          'dailyStepsGoal', 'dailyWaterGoalMl', 'dailySleepGoalHours', 'dailyActiveMinutesGoal',
          'onboardingCompleted', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.age is number && data.age >= 10 && data.age <= 120
        && data.gender is string && data.gender.size() <= 30 && data.gender in ['male', 'female', 'non_binary', 'prefer_not_to_say']
        && data.heightCm is number && data.heightCm >= 80 && data.heightCm <= 260
        && data.currentWeightKg is number && data.currentWeightKg >= 25 && data.currentWeightKg <= 400
        && data.targetWeightKg is number && data.targetWeightKg >= 25 && data.targetWeightKg <= 400
        && data.fitnessLevel is string && data.fitnessLevel.size() <= 20 && data.fitnessLevel in ['beginner', 'intermediate', 'advanced']
        && data.fitnessGoal is string && data.fitnessGoal.size() <= 30 && data.fitnessGoal in ['lose_weight', 'build_muscle', 'endurance', 'recomp', 'wellness']
        && data.workoutPreference is string && data.workoutPreference.size() <= 20 && data.workoutPreference in ['gym', 'home', 'outdoor', 'hybrid']
        && data.equipment is list && data.equipment.size() <= 12
        && (data.equipment.size() == 0 || (data.equipment[0] is string && data.equipment[0].size() <= 40))
        && data.dietaryPreference is string && data.dietaryPreference.size() <= 30 && data.dietaryPreference in ['balanced', 'high_protein', 'vegetarian', 'vegan', 'keto', 'mediterranean']
        && data.dailyCalorieGoal is number && data.dailyCalorieGoal >= 800 && data.dailyCalorieGoal <= 10000
        && data.dailyProteinGoalG is number && data.dailyProteinGoalG >= 20 && data.dailyProteinGoalG <= 600
        && data.dailyCarbsGoalG is number && data.dailyCarbsGoalG >= 0 && data.dailyCarbsGoalG <= 1200
        && data.dailyFatGoalG is number && data.dailyFatGoalG >= 10 && data.dailyFatGoalG <= 400
        && data.dailyStepsGoal is number && data.dailyStepsGoal >= 1000 && data.dailyStepsGoal <= 100000
        && data.dailyWaterGoalMl is number && data.dailyWaterGoalMl >= 500 && data.dailyWaterGoalMl <= 15000
        && data.dailySleepGoalHours is number && data.dailySleepGoalHours >= 4 && data.dailySleepGoalHours <= 14
        && data.dailyActiveMinutesGoal is number && data.dailyActiveMinutesGoal >= 5 && data.dailyActiveMinutesGoal <= 600
        && data.onboardingCompleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 2. UserPrivateInfo Blueprint Validation (PII Isolation)
    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 3. DailyLog Blueprint Validation
    function isValidDailyLog(data) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'steps', 'distanceKm', 'caloriesBurned', 'activeMinutes',
          'waterMl', 'sleepHours', 'sleepQuality', 'bedTime', 'wakeTime',
          'restingHeartRateBpm', 'fitnessScore', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'steps', 'distanceKm', 'caloriesBurned', 'activeMinutes',
          'waterMl', 'sleepHours', 'sleepQuality', 'bedTime', 'wakeTime',
          'restingHeartRateBpm', 'fitnessScore', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && isValidDateKey(data.dateKey)
        && data.steps is number && data.steps >= 0 && data.steps <= 200000
        && data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 500
        && data.caloriesBurned is number && data.caloriesBurned >= 0 && data.caloriesBurned <= 20000
        && data.activeMinutes is number && data.activeMinutes >= 0 && data.activeMinutes <= 1440
        && data.waterMl is number && data.waterMl >= 0 && data.waterMl <= 25000
        && data.sleepHours is number && data.sleepHours >= 0 && data.sleepHours <= 24
        && data.sleepQuality is string && data.sleepQuality.size() <= 20 && data.sleepQuality in ['poor', 'fair', 'good', 'excellent']
        && data.bedTime is string && data.bedTime.size() >= 4 && data.bedTime.size() <= 10
        && data.wakeTime is string && data.wakeTime.size() >= 4 && data.wakeTime.size() <= 10
        && data.restingHeartRateBpm is number && data.restingHeartRateBpm >= 0 && data.restingHeartRateBpm <= 240
        && data.fitnessScore is number && data.fitnessScore >= 0 && data.fitnessScore <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. WorkoutEntry Blueprint Validation
    function isValidWorkoutEntry(data) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'category', 'title', 'durationMin', 'caloriesBurned',
          'distanceKm', 'sets', 'reps', 'weightKg', 'exercisesSummary', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'category', 'title', 'durationMin', 'caloriesBurned',
          'distanceKm', 'sets', 'reps', 'weightKg', 'exercisesSummary', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && isValidDateKey(data.dateKey)
        && data.category is string && data.category.size() <= 30 && data.category in ['gym', 'home', 'cardio', 'running_walking', 'cycling', 'yoga']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.durationMin is number && data.durationMin >= 1 && data.durationMin <= 720
        && data.caloriesBurned is number && data.caloriesBurned >= 0 && data.caloriesBurned <= 10000
        && data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 500
        && data.sets is number && data.sets >= 0 && data.sets <= 200
        && data.reps is number && data.reps >= 0 && data.reps <= 5000
        && data.weightKg is number && data.weightKg >= 0 && data.weightKg <= 1000
        && data.exercisesSummary is string && data.exercisesSummary.size() <= 1000
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 5. MealEntry Blueprint Validation
    function isValidMealEntry(data) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'mealType', 'foodName', 'servingSize',
          'calories', 'proteinG', 'carbsG', 'fatG', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'mealType', 'foodName', 'servingSize',
          'calories', 'proteinG', 'carbsG', 'fatG', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && isValidDateKey(data.dateKey)
        && data.mealType is string && data.mealType.size() <= 20 && data.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
        && data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 120
        && data.servingSize is string && data.servingSize.size() >= 1 && data.servingSize.size() <= 60
        && data.calories is number && data.calories >= 0 && data.calories <= 10000
        && data.proteinG is number && data.proteinG >= 0 && data.proteinG <= 1000
        && data.carbsG is number && data.carbsG >= 0 && data.carbsG <= 1500
        && data.fatG is number && data.fatG >= 0 && data.fatG <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 6. BodyMeasurement Blueprint Validation
    function isValidBodyMeasurement(data) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'weightKg', 'bodyFatPct', 'bmi',
          'chestCm', 'waistCm', 'hipCm', 'armCm', 'note', 'localPhotoId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'weightKg', 'bodyFatPct', 'bmi',
          'chestCm', 'waistCm', 'hipCm', 'armCm', 'note', 'localPhotoId',
          'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && isValidDateKey(data.dateKey)
        && data.weightKg is number && data.weightKg >= 25 && data.weightKg <= 400
        && data.bodyFatPct is number && data.bodyFatPct >= 0 && data.bodyFatPct <= 75
        && data.bmi is number && data.bmi >= 8 && data.bmi <= 100
        && data.chestCm is number && data.chestCm >= 0 && data.chestCm <= 300
        && data.waistCm is number && data.waistCm >= 0 && data.waistCm <= 300
        && data.hipCm is number && data.hipCm >= 0 && data.hipCm <= 300
        && data.armCm is number && data.armCm >= 0 && data.armCm <= 150
        && data.note is string && data.note.size() <= 300
        && data.localPhotoId is string && data.localPhotoId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 7. ReminderSetting Blueprint Validation
    function isValidReminderSetting(data) {
      return data.keys().hasAll([
          'userId', 'category', 'label', 'time24h', 'enabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'category', 'label', 'time24h', 'enabled', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.category is string && data.category.size() <= 20 && data.category in ['workout', 'water', 'meal', 'sleep', 'goal', 'motivation']
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.time24h is string && data.time24h.size() == 5 && data.time24h.matches('^[0-9]{2}:[0-9]{2}$')
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update Profile & Targets
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'age', 'gender', 'heightCm', 'currentWeightKg', 'targetWeightKg',
            'fitnessLevel', 'fitnessGoal', 'workoutPreference', 'equipment', 'dietaryPreference',
            'dailyCalorieGoal', 'dailyProteinGoalG', 'dailyCarbsGoalG', 'dailyFatGoalG',
            'dailyStepsGoal', 'dailyWaterGoalMl', 'dailySleepGoalHours', 'dailyActiveMinutesGoal',
            'onboardingCompleted', 'updatedAt'
          ])
          ||
          // Action: Quick Weight Sync
          incoming().diff(existing()).affectedKeys().hasOnly(['currentWeightKg', 'updatedAt'])
        );
      allow delete: if false;

      // Subcollection: /users/{userId}/private/{docId} (PII Isolation)
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'info' && userExists(userId);
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && userExists(userId);
        allow delete: if false;
      }

      // Subcollection: /users/{userId}/dailyLogs/{logId}
      match /dailyLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && isValidDailyLog(incoming())
          && incoming().dateKey == logId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(logId)
          && isValidDailyLog(incoming())
          && incoming().userId == existing().userId
          && incoming().dateKey == existing().dateKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'steps', 'distanceKm', 'caloriesBurned', 'activeMinutes', 'waterMl',
            'sleepHours', 'sleepQuality', 'bedTime', 'wakeTime', 'restingHeartRateBpm',
            'fitnessScore', 'updatedAt'
          ])
          && userExists(userId);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(logId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/workouts/{workoutId}
      match /workouts/{workoutId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(workoutId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workoutId)
          && isValidWorkoutEntry(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(workoutId)
          && isValidWorkoutEntry(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey', 'category', 'title', 'durationMin', 'caloriesBurned',
            'distanceKm', 'sets', 'reps', 'weightKg', 'exercisesSummary', 'notes', 'updatedAt'
          ])
          && userExists(userId);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(workoutId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/meals/{mealId}
      match /meals/{mealId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(mealId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(mealId)
          && isValidMealEntry(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(mealId)
          && isValidMealEntry(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey', 'mealType', 'foodName', 'servingSize', 'calories',
            'proteinG', 'carbsG', 'fatG', 'updatedAt'
          ])
          && userExists(userId);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(mealId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/measurements/{measurementId}
      match /measurements/{measurementId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(measurementId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(measurementId)
          && isValidBodyMeasurement(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(measurementId)
          && isValidBodyMeasurement(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey', 'weightKg', 'bodyFatPct', 'bmi', 'chestCm',
            'waistCm', 'hipCm', 'armCm', 'note', 'localPhotoId', 'updatedAt'
          ])
          && userExists(userId);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(measurementId) && userExists(userId);
      }

      // Subcollection: /users/{userId}/reminders/{reminderId}
      match /reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(reminderId) && userExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(reminderId)
          && isValidReminderSetting(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(reminderId)
          && isValidReminderSetting(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'category', 'label', 'time24h', 'enabled', 'updatedAt'
          ])
          && userExists(userId);
        allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId) && isValidId(reminderId) && userExists(userId);
      }
    }
  }
}
